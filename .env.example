# Copy to .env and fill in your values. .env is gitignored.
PORT=3000
# Paste your new Atlas URI here when ready. If empty, app falls back to the old hardcoded URI for smoke testing.
MONGODB_URI=
SESSION_SECRET=dev-only-change-me-32-chars-min
# Optional — only needed for mentor-application / feedback emails
EMAIL_USER=
EMAIL_PASS=
